<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/bg_splash"
    android:padding="32dp">

    <!-- Logo (Bag & Magnifier Squircle) -->
    <ImageView
        android:id="@+id/ivSplashLogo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_campusfind_logo"
        android:scaleType="fitCenter"
        android:contentDescription="CampusFind Logo" />

    <!-- Stylized App Name Wordmark -->
    <ImageView
        android:id="@+id/ivSplashAppName"
        android:layout_width="220dp"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/ic_campusfind_wordmark_white"
        android:scaleType="fitCenter"
        android:alpha="0"
        android:contentDescription="CampusFind" />

    <!-- Tagline -->
    <TextView
        android:id="@+id/tvSplashTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="FIND LOST. RETURN FOUND."
        android:textColor="#F47920"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.2"
        android:alpha="0" />

    <!-- Loading dots -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:orientation="horizontal"
        android:gravity="center">

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_margin="3dp"
            android:background="#80F47920"
            android:backgroundTint="#80F47920" />
        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_margin="3dp"
            android:background="#B0F47920"
            android:backgroundTint="#B0F47920" />
        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_margin="3dp"
            android:background="#F47920"
            android:backgroundTint="#F47920" />
    </LinearLayout>

</LinearLayout>
